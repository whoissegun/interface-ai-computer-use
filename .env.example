# Copy this file to .env. Never commit the real key.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Stage 0 defaults. Every value can also be supplied as a CLI flag.
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_REASONING_EFFORT=high
TARGET_APP_URL=https://target-app-gamma.vercel.app/
