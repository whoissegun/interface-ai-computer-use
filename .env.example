# Copy this file to .env. Never commit the real key.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Stage 0 defaults. Every value can also be supplied as a CLI flag.
OPENROUTER_MODEL=moonshotai/kimi-k2.6
OPENROUTER_REASONING_EFFORT=high
TARGET_APP_URL=https://target-app-gamma.vercel.app/

# Natural-language capability router defaults.
OPENROUTER_ROUTER_MODEL=moonshotai/kimi-k2.6
OPENROUTER_ROUTER_REASONING_EFFORT=medium
